# Copy to .env.local. The values below run against the local Firebase emulator
# suite (see emulator/); swap in a real project's settings for staging/production.

# --- Firebase web app config (browser SDK) ---
NEXT_PUBLIC_FIREBASE_API_KEY=demo-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-app.firebaseapp.com
# Also used by middleware.ts to verify session tokens.
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-app
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-app.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=0
NEXT_PUBLIC_FIREBASE_APP_ID=demo

# --- Local emulators (leave all of these unset in production) ---
# Browser SDK: emulator host plus per-service ports.
NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_PORT=9099
NEXT_PUBLIC_FIRESTORE_EMULATOR_PORT=8080
NEXT_PUBLIC_STORAGE_EMULATOR_PORT=9199
# firebase-admin: host:port of each emulator.
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# --- firebase-admin service account (production; not needed with the emulators) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the \n escapes; they are turned into newlines at runtime.
FIREBASE_PRIVATE_KEY=

# --- App ---
# Public URL, used in emails and checkout redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3507
# Comma-separated emails that get the admin role on sign-in.
ADMIN_EMAILS=
# Set by Next.js (development / production); no need to set it yourself.
# NODE_ENV=

# --- Sample data (npm run seed) ---
# Sign-in for the seeded job seeker; the seeded employer (talent@example.com)
# uses the same password. Defaults: maya@example.com / sample-password, and the
# password is required when seeding a real project.
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=

# --- AI (optional): Gemini key. Without one, the offline model answers. ---
# GEMINI_API_KEY and GOOGLE_API_KEY are accepted as alternatives.
GOOGLE_GENAI_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=

# --- Email (optional): welcome and application-status emails via Resend ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Payments: Stripe checkout for paid plans ---
# src/lib/stripe.ts throws without STRIPE_SECRET_KEY, so `npm run build` needs it;
# any placeholder (e.g. sk_test_placeholder) works when payments are not used.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_MONTHLY_PRICE_ID=
STRIPE_STARTER_YEARLY_PRICE_ID=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=
STRIPE_PREMIUM_MONTHLY_PRICE_ID=
STRIPE_PREMIUM_YEARLY_PRICE_ID=
STRIPE_BUSINESS_MONTHLY_PRICE_ID=
STRIPE_BUSINESS_YEARLY_PRICE_ID=

# --- Uploads (optional): Cloudinary; without it images are stored inline ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
